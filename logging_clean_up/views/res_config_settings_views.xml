<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_config_settings_logging_cleanup" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.logging.cleanup</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!-- Add Logging Cleanup fields inside General Settings, before Developer Tools -->
            <xpath expr="//widget[@name='res_config_dev_tool']" position="before">
                <h2>Logging Cleanup</h2>
                <div class="row mt16 o_settings_container">
                    <div class="col-6 o_setting_box">
                        <div class="o_setting_left_pane">
                            <field name="log_cleanup_enabled"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="log_cleanup_enabled"/>
                            <div class="text-muted">
                                Enable automated log cleanup via scheduled action
                            </div>
                        </div>
                    </div>
                    <div class="col-6 o_setting_box" attrs="{'invisible': [('log_cleanup_enabled', '!=', True)]}">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="rotation_mode"/>
                            <div class="text-muted">
                                Select the rotation strategy for log cleanup
                            </div>
                            <div class="row">
                                <field name="rotation_mode"/>
                            </div>
                        </div>
                    </div>
                </div>
                
                <div class="row mt16 o_settings_container" attrs="{'invisible': [('log_cleanup_enabled', '!=', True)]}">
                    <div class="col-6 o_setting_box" attrs="{'invisible': [('rotation_mode', '!=', 'time')]}">
                        <div class="o_setting_left_pane">
                            <field name="log_retention_days"/>
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="log_retention_days"/>
                            <div class="text-muted">
                                Default retention period for logs (days) when level-specific rules don't apply
                            </div>
                        </div>
                    </div>
                    <div class="col-6 o_setting_box" attrs="{'invisible': [('rotation_mode', '!=', 'time')]}">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="log_level_retention_rules"/>
                            <div class="text-muted">
                                JSON configuration for retention days per log level. Format: {"DEBUG": 3, "INFO": 7, "WARNING": 30, "ERROR": 90, "CRITICAL": 180}
                            </div>
                            <div class="row">
                                <field name="log_level_retention_rules" widget="text"/>
                            </div>
                        </div>
                    </div>
                    <div class="col-6 o_setting_box" attrs="{'invisible': [('rotation_mode', '!=', 'count')]}">
                        <div class="o_setting_left_pane">
                        </div>
                        <div class="o_setting_right_pane">
                            <label for="rotation_max_records"/>
                            <div class="text-muted">
                                Maximum number of log records to keep in count-based rotation mode
                            </div>
                            <div class="row">
                                <field name="rotation_max_records"/>
                            </div>
                        </div>
                    </div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
