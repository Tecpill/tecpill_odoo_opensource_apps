<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Scheduled action for automated log cleanup -->
    <record id="ir_cron_logging_cleanup" model="ir.cron">
        <field name="name">Logging Cleanup: Automated Cleanup</field>
        <field name="model_id" ref="base.model_ir_logging"/>
        <field name="state">code</field>
        <field name="code">model.cleanup_logs()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active" eval="True"/>
        <field name="user_id" ref="base.user_root"/>
    </record>
</odoo>
