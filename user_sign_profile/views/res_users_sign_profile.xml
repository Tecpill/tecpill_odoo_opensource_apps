<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Sign module's view (for admin/user management views) -->
    <record id="res_users_view_form_sign_profile" model="ir.ui.view">
        <field name="name">res.users.form.sign.profile</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="sign.res_users_view_form"/>
        <field name="arch" type="xml">
            <!-- Change groups attribute and add context on parent group (cleaner than per-field) -->
            <!-- Use explicit XPath for resilience in case multiple groups share the same name -->
            <xpath expr="//group[@name='sign']" position="attributes">
                <attribute name="groups">base.group_user</attribute>
                <attribute name="context">{'user_sign_profile_only': True}</attribute>
            </xpath>
        </field>
    </record>

    <!-- Inherit HR profile view (for "My Profile" / user preferences) -->
    <!-- Add signature group to existing Preferences page -->
    <record id="res_users_view_form_profile_sign_profile" model="ir.ui.view">
        <field name="name">res.users.form.profile.sign</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile"/>
        <field name="arch" type="xml">
            <!-- Add Digital Signatures group after email signature group in Preferences page -->
            <!-- The Preferences page exists (added by base view or another module) -->
            <xpath expr="//page[@name='preferences_page']//group[@name='signature']" position="after">
                <group string="Digital Signatures" name="sign" groups="base.group_user" context="{'user_sign_profile_only': True}">
                    <field name="sign_signature" widget="signature" options="{'full_name': 'display_name', 'size': ['',200]}"/>
                    <field name="sign_initials" widget="signature" options="{'size': [200,'']}"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
