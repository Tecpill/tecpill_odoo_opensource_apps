<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Employee Public Form View to add Extension field -->
    <record id="view_employee_public_form_inherit_extension" model="ir.ui.view">
        <field name="name">hr.employee.public.form.inherit.extension</field>
        <field name="model">hr.employee.public</field>
        <field name="inherit_id" ref="hr.hr_employee_public_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='work_phone']" position="after">
                <field name="extension_number" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>
