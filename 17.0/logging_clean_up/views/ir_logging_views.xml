<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extend ir.logging list view to add Clean Now button -->
    <record id="view_ir_logging_list_inherit" model="ir.ui.view">
        <field name="name">ir.logging.list.inherit</field>
        <field name="model">ir.logging</field>
        <field name="inherit_id" ref="base.ir_logging_tree_view"/>
        <field name="arch" type="xml">
            <!-- Add Clean Now button in the list header -->
            <xpath expr="//tree" position="inside">
                <header>
                    <button name="action_clean_logs_now" 
                            string="Run Cleanup (Per Settings)" 
                            type="object" 
                            class="btn-primary"
                            icon="fa-trash"/>
                </header>
            </xpath>
        </field>
    </record>
    
    <!-- Add optional filters for ir.logging -->
    <record id="view_ir_logging_search_inherit" model="ir.ui.view">
        <field name="name">ir.logging.search.inherit</field>
        <field name="model">ir.logging</field>
        <field name="inherit_id" ref="base.ir_logging_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//filter" position="after">
                <separator/>
                <filter string="By Level" name="group_by_level" context="{'group_by': 'level'}"/>
            </xpath>
        </field>
    </record>
</odoo>
